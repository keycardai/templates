KEYCARD_URL="https://<zone-id>.keycard.cloud"
PORT=8000
KEYCARD_RESOURCE_ID=http://localhost:8000/mcp
KEYCARD_DOWNSTREAM_URL=http://localhost:8000/profile
# Defaults to KEYCARD_DOWNSTREAM_URL. Set it if the registered audience differs.
# KEYCARD_DOWNSTREAM_RESOURCE_ID=http://localhost:8000/profile

# Supply the application credential through the process environment.
KEYCARD_CLIENT_ID=
KEYCARD_CLIENT_SECRET=
