# Runtime config for the MCP server.
# Copy to .env and fill in.

KEYCARD_URL=https://<your-zone-id>.keycard.cloud
PORT=8000
# Optional: defaults to http://localhost:<PORT>/mcp.
# For a public deployment, set this to the public MCP URL registered in Keycard.
# KEYCARD_RESOURCE_ID=http://localhost:8000/mcp
