# Runtime config for the MCP server.
# Copy to .env and fill in.

KEYCARD_URL=https://<your-zone-id>.keycard.cloud
# This must match the MCP URL registered in Keycard. For a public deployment,
# use the public MCP URL. If unset, it defaults to http://localhost:<PORT>/mcp.
KEYCARD_RESOURCE_ID=http://localhost:8000/mcp
PORT=8000
