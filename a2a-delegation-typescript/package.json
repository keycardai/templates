    "ci:verify": "bash scripts/ci-verify.sh"
  },
  "dependencies": {
    "@keycardai/a2a": "^0.6.1",
    "@keycardai/express": "^0.12.0",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.9"
  }
}
