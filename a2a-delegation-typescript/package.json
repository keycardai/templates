{
  "name": "a2a-delegation-typescript",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start:caller": "node --env-file-if-exists=.env dist/index.js caller",
